{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnapLingo",
  "version": "0.1.0",
  "identifier": "com.snaplingo.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/snaplingo-ocr",
      "binaries/snaplingo-translate"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libxdo3",
          "libayatana-appindicator3-1",
          "libwebkit2gtk-4.1-0"
        ]
      }
    }
  },
  "plugins": {}
}